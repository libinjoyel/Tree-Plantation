# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# JWT Configuration (use a strong random secret of 32+ characters in production)
JWT_SECRET=replace-with-a-strong-random-jwt-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS Configuration (exact frontend origin in production, comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# OpenWeather API (server-side weather proxy)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Logging
LOG_LEVEL=info
